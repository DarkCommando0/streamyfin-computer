<Page
    x:Class="Streamyfin.Windows.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Streamyfin.Windows.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Black">

    <Grid>
        <!-- Background Hero Backdrop Image for the Login Page -->
        <Grid>
            <!-- A subtle gradient or image background could go here -->
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#201040" Offset="0.0" />
                        <GradientStop Color="#000000" Offset="0.5" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <!-- Login Form Container -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="380" Spacing="24" Padding="32" Background="#1A1A1A" CornerRadius="12">
            
            <!-- App Logo / Title -->
            <StackPanel HorizontalAlignment="Center" Spacing="8" Margin="0,0,0,16">
                <!-- Using a simple text for Streamyfin logo -->
                <TextBlock Text="Streamyfin" 
                           FontSize="42" 
                           FontWeight="Bold" 
                           Foreground="{ThemeResource SystemAccentColor}" 
                           HorizontalAlignment="Center" />
                <TextBlock Text="Connect to your Jellyfin Server" 
                           Foreground="#AAAAAA" 
                           FontSize="14" 
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Input Fields -->
            <StackPanel Spacing="16">
                <TextBox x:ConnectionId='3' x:Name="ServerUrlBox" 
                         Header="Server URL" 
                         PlaceholderText="https://..." 
                         Style="{ThemeResource DefaultTextBoxStyle}" />
                
                <TextBox x:ConnectionId='4' x:Name="UsernameBox" 
                         Header="Username" 
                         PlaceholderText="Enter username" />
                
                <PasswordBox x:ConnectionId='5' x:Name="PasswordBox" 
                             Header="Password" 
                             PlaceholderText="Enter password" />
            </StackPanel>

            <!-- Login Action -->
            <Button x:ConnectionId='2' x:Name="LoginButton"
                    Content="Connect"
                                             
                    Background="{ThemeResource SystemAccentColor}"
                    Foreground="White"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Stretch"
                    Height="44"
                    CornerRadius="6"
                    Margin="0,8,0,0"/>

        </StackPanel>
    </Grid>
</Page>

