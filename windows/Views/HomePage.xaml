<Page
    x:Class="Streamyfin.Windows.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Streamyfin.Windows.Views"
    xmlns:vm="using:Streamyfin.Windows.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Black">



    <Page.Resources>
        <!-- Reusable Horizontal Items Panel -->
        <ItemsPanelTemplate x:Key="HorizontalItemsPanel">
            <ItemsStackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>

        <!-- Template for Media Items -->
        <DataTemplate x:Key="MediaItemTemplate" x:DataType="vm:MediaItem">
            <Grid Width="260" Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Poster Image Area -->
                <Grid Height="146" CornerRadius="8">
                    <Rectangle Fill="#1A1A1A" />
                    <!-- The Purple Diagonal Ribbon top right -->
                    <Polygon Points="0,0 32,0 32,32" Fill="{ThemeResource SystemAccentColor}" 
                             HorizontalAlignment="Right" VerticalAlignment="Top"
                             Visibility="{x:Bind RibbonVisibility}"/>
                </Grid>

                <!-- Texts directly below -->
                <TextBlock Grid.Row="1" Text="{x:Bind Title}" FontWeight="SemiBold" 
                           Foreground="White" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
                
                <TextBlock Grid.Row="2" Text="{x:Bind Subtitle}" FontSize="12" 
                           Foreground="#888888" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer Padding="32">
        <StackPanel Spacing="32">
            
            <TextBlock Text="Streamyfin" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="Bold" Foreground="White" />

            <!-- Continue Watching -->
            <StackPanel Spacing="16">
                <TextBlock Text="Continue Watching" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold" Foreground="White" />
                <ListView ItemsSource="{Binding ContinueWatchingItems}"
                          ItemTemplate="{StaticResource MediaItemTemplate}"
                          ItemsPanel="{StaticResource HorizontalItemsPanel}"
                          SelectionMode="Single"
                          IsItemClickEnabled="True"
                          ItemClick="MediaList_ItemClick"
                          ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          ScrollViewer.HorizontalScrollMode="Enabled"
                          ScrollViewer.VerticalScrollMode="Disabled"/>
            </StackPanel>

            <!-- Next Up -->
            <StackPanel Spacing="16">
                <TextBlock Text="Next Up" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold" Foreground="White" />
                <ListView ItemsSource="{Binding NextUpItems}"
                          ItemTemplate="{StaticResource MediaItemTemplate}"
                          ItemsPanel="{StaticResource HorizontalItemsPanel}"
                          SelectionMode="Single"
                          IsItemClickEnabled="True"
                          ItemClick="MediaList_ItemClick"
                          ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          ScrollViewer.HorizontalScrollMode="Enabled"
                          ScrollViewer.VerticalScrollMode="Disabled"/>
            </StackPanel>

            <!-- Collections -->
            <StackPanel Spacing="16">
                <TextBlock Text="Collections" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold" Foreground="White" />
                <ListView ItemsSource="{Binding CollectionItems}"
                          ItemTemplate="{StaticResource MediaItemTemplate}"
                          ItemsPanel="{StaticResource HorizontalItemsPanel}"
                          SelectionMode="Single"
                          IsItemClickEnabled="True"
                          ItemClick="MediaList_ItemClick"
                          ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          ScrollViewer.HorizontalScrollMode="Enabled"
                          ScrollViewer.VerticalScrollMode="Disabled"/>
            </StackPanel>

            <!-- Suggestions -->
            <StackPanel Spacing="16">
                <TextBlock Text="Suggestions" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold" Foreground="White" />
                <ListView ItemsSource="{Binding SuggestionItems}"
                          ItemTemplate="{StaticResource MediaItemTemplate}"
                          ItemsPanel="{StaticResource HorizontalItemsPanel}"
                          SelectionMode="Single"
                          IsItemClickEnabled="True"
                          ItemClick="MediaList_ItemClick"
                          ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          ScrollViewer.HorizontalScrollMode="Enabled"
                          ScrollViewer.VerticalScrollMode="Disabled"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
